    "sharedRules": [
      {
        "name": "Anathema Beam",
        "id": "c9d4-8f77-0a00-1e0b",
        "description": "Any ships in Fore arc require one additional success to pass the effects of the Dimensional Pulse. Range is unlimited.",
        "hidden": false,
        "page": 25,
        "publicationId": "b97a-2104-pub1"
      },
      {
        "name": "Difficult Target",
        "id": "d23f-f626-1592-885a",
        "description": "If a Capital Class model makes a ranged attack against a Difficult Target, their Attack Dice will suffer a -1 ‘to hit’ modifier. Most commonly, this will mean that their Attack Dice will only score hits on a 5 or 6.",
        "hidden": false,
        "page": 0
      },
      {
        "name": "Dimensional Pulse",
        "id": "b2b3-afd7-37d7-772e",
        "description": "Pulse initiated before start of turn, after TAC phase. All models without the Unyielding Construct MAR take unmodified command check. Weapon AD indicate number of required successes. Failure moves the ship xD6\" with x = Tier of ship. Models touching any acrylic part of gate are destroyed.",
        "hidden": false,
        "page": 25,
        "publicationId": "b97a-2104-pub1"
      },
      {
        "name": "Elusive Target",
        "id": "f802-9135-40c1-1647",
        "description": "An Elusive Target is only hit on a 6 by all Weapons Systems attacks from Capital Class models, and on a 5 or 6 by non-Capital Class models.",
        "hidden": false,
        "page": 0
      },
      {
        "name": "Maneuverable",
        "id": "fa5f-8e4e-0803-c14b",
        "description": "If a Maneuverable model is at a Full Stop, it can rotate up to 90 degrees around its Flight Peg during the Secondary Movement segment of its activation.",
        "hidden": false,
        "page": 0
      },
      {
        "name": "Unmanned",
        "id": "5e4d-f402-ab8a-5f04",
        "description": "An Unmanned model does not suffer Crew Loss penalties for having zero Crew.",
        "hidden": false,
        "page": 0
      },
      {
        "name": "Unyielding Construct",
        "id": "30a8-41f7-c1e4-8b31",
        "description": "Model does not suffer critical hit effects, targeted strike effects or Cyberwarfare effects except those that refer to CP loss.",
        "hidden": false,
        "page": 25,
        "publicationId": "b97a-2104-pub1"
      }
    ],
